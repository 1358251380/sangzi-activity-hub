# ===== 服务配置 =====
# 后端监听端口（1-65535，非法值会导致启动失败）
PORT=3001

# 监听地址：0.0.0.0 表示所有网卡；容器内必须是 0.0.0.0
HOST=0.0.0.0

# SQLite 数据库文件路径（相对项目根目录，也可用绝对路径）
DB_PATH=./data/app.db

# 运行环境：development | production | test
# production 模式下由后端单端口托管 web/dist 静态产物
NODE_ENV=development

# 日志格式：json | text
# 不填时：production 默认 json（便于采集），其他默认 text（便于人读）
#LOG_FORMAT=json

# Express trust proxy：true | false | 跳数(0-10) | loopback | linklocal | uniquelocal
# 放在 Nginx 等反向代理后面时应保持 1，以便正确识别客户端 IP 与协议
TRUST_PROXY=1

# 开发期允许的前端跨域来源（生产同源无需此项）
CORS_ORIGIN=http://localhost:5173

# ===== 备份配置（scripts/backup.mjs）=====
# 备份目录，默认 data/backups
#BACKUP_DIR=./data/backups
# 保留最近几份备份，默认 7
#BACKUP_KEEP=7
